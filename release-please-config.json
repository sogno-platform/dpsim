{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Added"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "perf",
      "section": "Changed"
    },
    {
      "type": "refactor",
      "section": "Changed"
    },
    {
      "type": "revert",
      "section": "Removed"
    },
    {
      "type": "security",
      "section": "Security"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "build",
      "section": "Changed",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Changed",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Changed",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Changed",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Changed",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "extra-files": [
        "CMakeLists.txt",
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.project.version"
        }
      ]
    }
  }
}
